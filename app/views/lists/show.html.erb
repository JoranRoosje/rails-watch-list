<h1><%= @list.name %></h1>
<ul>
  <% @list.bookmarks.each do |bookmark| %>
    <li>
      <p><%= bookmark.comment %> <%= link_to "Delete", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></p>
      <p><%= bookmark.movie.title %></p>
    </li>
  <% end %>
</ul>
<%= link_to "back to lists", lists_path %>
<%= link_to "add bookmark", new_list_bookmark_path(@list) %>
